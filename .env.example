# Copy to .env and fill in. Never commit .env.

# SEC EDGAR asks every client to identify itself with a name and contact email.
SEC_USER_AGENT="OpenSec Analyst you@example.com"

OPENAI_API_KEY=
MODEL_NAME=gpt-6.1-terra
MODEL_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-large

# Docker Compose. macOS AirPlay holds port 5000, so MLflow defaults to 5001.
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001
POSTGRES_PORT=5432
POSTGRES_DB=opensec
POSTGRES_USER=opensec
POSTGRES_PASSWORD=

# Model prices in USD per million tokens, used to compute cost (decision 11).
# Leave empty to report tokens only.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
